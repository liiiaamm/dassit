# Copy to .env and fill in. docker compose reads it automatically. Never commit .env.

# Models Ollama pulls on first start (comma-separated), and the one the backend uses
OLLAMA_MODELS=llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# PostgreSQL
POSTGRES_DB=das_db
POSTGRES_USER=das_user
POSTGRES_PASSWORD=<choose-a-password>

# Django: generate a key with
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=<paste-a-generated-key>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
