# For running the backend outside Docker. Copy to backend/restApi/.env
USE_POSTGRES=false            # true to use PostgreSQL, false for a local SQLite file
POSTGRES_DB=das_db
POSTGRES_USER=das_user
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=<paste-a-generated-key>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
